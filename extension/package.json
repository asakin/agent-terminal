{
  "name": "agent-terminal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "wxt": ">=0.21.5 <1"
  },
  "dependencies": {
    "@xterm/addon-attach": ">=0.12.0 <1",
    "@xterm/addon-fit": ">=0.11.0 <1",
    "@xterm/addon-web-links": ">=0.12.0 <1",
    "@xterm/addon-webgl": ">=0.19.0 <1",
    "@xterm/xterm": "^6.0.0"
  }
}
